# Origin used by the Vite dev-server proxy only. Set this to the backend's
# actual origin; the port is intentionally environment-specific. This value
# is never shipped to the client bundle — it only tells `vite dev` where to
# forward the 8 backend prefixes (auth, members, admin, learning,
# documentation, projects, operations, health).
VITE_BACKEND_ORIGIN=

# Same-origin is the supported production topology. Leave this empty when a
# reverse proxy exposes the backend paths on the frontend origin, so the
# client calls /auth, /members, ... on the same host (refresh cookie stays
# first-party). Set it only for topologies where the API lives on a
# different origin.
VITE_API_BASE_URL=
